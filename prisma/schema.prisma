// =============================================================================
// Prisma schema - Tyre Fitting Near Me Ltd
// -----------------------------------------------------------------------------
// Database: PostgreSQL (running in Docker on a Hostinger VPS).
// App:      Next.js on Vercel (serverless) - see connection-pooling notes below.
//
// Two connection URLs (Prisma's recommended serverless setup):
//   DATABASE_URL  -> POOLED connection used by the app at runtime. Point this at
//                    PgBouncer (transaction mode) once you add it, and append
//                    `?pgbouncer=true&sslmode=require`. Until PgBouncer exists it
//                    can equal DIRECT_URL.
//   DIRECT_URL    -> DIRECT connection (no pooler) used by `prisma migrate` and
//                    `prisma db push`, which need a real session. This is your
//                    VPS Postgres on port 32768.
//
// Fill both in `.env.local` (local dev) and in the Vercel project env vars.
// NEVER commit real credentials - see `.env.example` for the format.
//
// NOTE: "enum-like" fields are plain Strings with allowed values documented in
// comments, to keep the admin forms simple and migrations painless.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (runtime / serverless)
  directUrl = env("DIRECT_URL") // direct (migrations)
}

// -----------------------------------------------------------------------------
// Site settings - a single row (id = "settings") edited from the admin.
// Holds global NAP/contact info reused across the whole site + header/footer.
// SERVICE-AREA business: NO street address is stored anywhere.
// -----------------------------------------------------------------------------
model SiteSetting {
  id        String  @id @default("settings")
  brandName String  @default("Tyre Fitting Near Me Ltd")
  tagline   String  @default("24/7 Mobile Tyre Fitting - We Come To You")
  logo      String? // header logo image (Vercel Blob / uploads)
  favicon   String? // browser tab icon

  // Contact / conversion details
  phone        String @default("")
  whatsapp     String @default("") // international format, e.g. 447000000000
  email        String @default("")
  openingHours String @default("24/7, 365 days a year")

  // Trust counters shown on the homepage
  yearsExperience Int @default(10)
  customersServed Int @default(15000)
  brandsCount     Int @default(50)

  // Social profiles (optional)
  facebookUrl  String?
  instagramUrl String?
  tiktokUrl    String?

  // Default SEO fallbacks
  defaultMetaTitle       String @default("Mobile Tyre Fitting Near Me | 24/7 Call-Out")
  defaultMetaDescription String @default("24/7 mobile tyre fitting that comes to you - home, work or roadside. Fast call-out across London, Kent, Sussex, Essex, the West Midlands & Scotland.")
  defaultOgImage         String?

  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Services - one row per service, rendered by the /services/[service] template.
// -----------------------------------------------------------------------------
model Service {
  id               String  @id @default(cuid())
  title            String
  slug             String  @unique
  shortDescription String // used in grids/cards + meta description fallback
  body             String  @default("") // rich-text HTML from the editor
  icon             String? // lucide icon name, e.g. "wrench"
  heroImage        String?
  features         Json    @default("[]") // string[] of bullet points
  priceFrom        String? // free text, e.g. "from £25"

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImage        String?

  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faqs    Faq[]
  reviews Review[]

  @@index([slug])
  @@index([published, order])
}

// -----------------------------------------------------------------------------
// FAQs - reusable. Attach to a service, or leave the relation null for a
// GENERAL/global FAQ shown on the homepage & /faq.
// -----------------------------------------------------------------------------
model Faq {
  id       String @id @default(cuid())
  question String
  answer   String // plain text / light HTML
  category String @default("general") // "general" | "service" | "location"

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, published])
  @@index([serviceId])
}

// -----------------------------------------------------------------------------
// Reviews - reusable. Attach to a service for social proof, or leave the
// relation null for a global review shown on the homepage & /reviews.
// -----------------------------------------------------------------------------
model Review {
  id       String   @id @default(cuid())
  author   String
  rating   Int      @default(5) // 1-5
  text     String
  location String? // free text, e.g. "Maidstone, Kent"
  source   String   @default("Google") // "Google" | "Trustpilot" | "Facebook" | ...
  date     DateTime @default(now())
  featured Boolean  @default(false)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, featured])
  @@index([serviceId])
}

// -----------------------------------------------------------------------------
// Blog posts - tyre safety / advice articles, /blog/[slug]
// -----------------------------------------------------------------------------
model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @default("")
  coverImage  String?
  body        String    @default("") // rich-text HTML
  author      String    @default("Tyre Fitting Near Me Ltd")
  tags        Json      @default("[]") // string[]
  publishedAt DateTime?
  published   Boolean   @default(false)

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImage        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([published, publishedAt])
}

// -----------------------------------------------------------------------------
// Leads / bookings - submissions from the public forms. Captured here so the
// owner can see every enquiry in the admin, not just in the notification email.
//   type "booking"      -> full booking/quote form (name, phone, etc.)
//   type "availability" -> hero "check availability" search (postcode only)
// -----------------------------------------------------------------------------
model Lead {
  id         String   @id @default(cuid())
  // Correlates the hero availability search with the booking the same visitor
  // later submits, so one enquiry is a single row (the booking upgrades the
  // search) instead of two. Null for leads from standalone forms.
  sessionKey String?  @unique
  type       String   @default("booking") // "booking" | "availability"
  name       String   @default("")
  phone      String   @default("")
  postcode   String   @default("")
  tyreSize   String   @default("")
  service    String   @default("")
  message    String   @default("")
  source     String   @default("") // page/path the lead came from (optional)
  status     String   @default("new") // "new" | "contacted" | "booked" | "closed"
  adminNotes String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}
