# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc / OS
.DS_Store
Thumbs.db

# secrets, keys & certificates — never commit these
*.pem
*.key
*.crt
*.p12
*.pfx

# debug / logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor / IDE
.vscode/
.idea/

# local env files — ignore ALL .env* (incl. .env.local secrets) except the template
.env*
!.env.example

# local Prisma artifacts
/prisma/*.db
/prisma/*.db-journal

# user-uploaded media (served from /public/uploads at runtime)
/public/uploads/*
!/public/uploads/.gitkeep
# ...but DO commit curated brand logos so they deploy
!/public/uploads/brands
!/public/uploads/brands/**

# internal working notes (not for the repo)
/PROJECT-NOTES.md
/WORK-LOG.md

# vercel / build tooling
/.vercel
/.turbo
/coverage
*.tsbuildinfo
SEO-TECHNICAL-AUDIT.md
