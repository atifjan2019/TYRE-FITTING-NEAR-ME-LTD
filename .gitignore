# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — ignore ALL .env* except the committed template
.env*
!.env.example

# local Prisma artifacts
/prisma/*.db
/prisma/*.db-journal

# user-uploaded media (served from /public/uploads at runtime)
/public/uploads/*
!/public/uploads/.gitkeep

# vercel / typescript build info
/.vercel
*.tsbuildinfo
